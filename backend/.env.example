# Copy this file to .env (or export these vars directly) before running the
# backend against Supabase/PostgreSQL. Without DATABASE_URL set, the app
# falls back to a local SQLite file at data/freight.db for zero-setup dev.

# --- Supabase / PostgreSQL connection ---
# Get this from Supabase: Project Settings -> Database -> Connection string
# (use the "Session pooler" or direct connection string, SQLAlchemy dialect
# prefix required: postgresql+psycopg2://)
DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres?sslmode=require

# --- Optional: Supabase project API credentials ---
# Only needed if you later add Supabase client-side features (e.g. auth,
# storage). Not required for the FastAPI backend, which talks to Postgres
# directly via DATABASE_URL / SQLAlchemy.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=<anon-key>

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS (Phase 2 frontend origin, comma-separated if multiple) ---
CORS_ALLOW_ORIGINS=http://localhost:5173
